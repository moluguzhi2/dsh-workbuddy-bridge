# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
- id: web
  name: "@deepseek-ai/dsh-web"
  config:
    searchProvider: deepseek-search-api
    fetchProvider: deepseek-fetch-api
- id: ui-settings-general
  name: "@deepseek-ai/dsh-client-ui-settings-general"
  config:
    welcomeNoticeVersion: 2026-09-28.1
- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      custom-wb-bridge:
        displayName: WB-Bridge
        api: openai-completions
        baseURL: http://127.0.0.1:19427/v1
        # 不放 apiKeyEnv：引用解析不到会让 app 判 MISSING_CREDENTIAL，
        # 显示「API Key 无效或已过期」且请求根本发不出来。
        # OpenAI 协议仍要 Authorization 头，用字面占位值（桥不校验 key）。
        headers:
          Authorization: Bearer wb-bridge
        models:
          - id: auto
            contextWindow: 256000
            maxTokens: 32000
          - id: hy4free
            contextWindow: 960000
            maxTokens: 64000
          - id: hy4std
            contextWindow: 960000
            maxTokens: 64000
          - id: fast-model
            contextWindow: 300000
            maxTokens: 48000
          - id: balanced-model
            contextWindow: 300000
            maxTokens: 48000
          - id: deep-model
            contextWindow: 300000
            maxTokens: 48000
          - id: hy3
            contextWindow: 192000
            maxTokens: 64000
          - id: hy3-x
            contextWindow: 192000
            maxTokens: 64000
          - id: default
            contextWindow: 200000
            maxTokens: 24000
          - id: glm-5.3
            contextWindow: 1000000
            maxTokens: 64000
          - id: glm-5.3-flash
            contextWindow: 1000000
            maxTokens: 131072
          - id: glm-5.2
            contextWindow: 1000000
            maxTokens: 64000
          - id: kimi-k3-1
            contextWindow: 1000000
            maxTokens: 32000
          - id: kimi-k2.8-preview
            contextWindow: 1000000
            maxTokens: 64000
          - id: kimi-k2.5
            contextWindow: 164000
            maxTokens: 32000
          - id: deepseek-v4-flash
            contextWindow: 1000000
            maxTokens: 50000
          - id: deepseek-v4.1-flash
            contextWindow: 1000000
            maxTokens: 128000
          - id: deepseek-v4-pro
            contextWindow: 1000000
            maxTokens: 128000
          - id: deepseek-v3-2-volc
            contextWindow: 96000
            maxTokens: 32000
          - id: hunyuan-chat
            contextWindow: 200000
            maxTokens: 8192
          - id: space-bunny
            contextWindow: 1000000
            maxTokens: 128000
          - id: step-5-preview
            contextWindow: 1000000
            maxTokens: 64000
          - id: mimo-v2.6-pro
            contextWindow: 1000000
            maxTokens: 128000
          - id: minimax-m3.1-flash
            contextWindow: 1000000
            maxTokens: 128000
          - id: kimi-k3.1-pro
            contextWindow: 1000000
            maxTokens: 32000
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: custom-wb-bridge
    model: hy3
- id: agent-preset-registry
  name: "@deepseek-ai/dsh-agent-preset-registry"
  config:
    default: standard
    selectedDefault: free
